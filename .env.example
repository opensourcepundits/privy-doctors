# Local Docker Postgres. On Vercel, the Neon integration replaces this with the pooled Neon URL.
DATABASE_URL=postgres://clinica:clinica@localhost:5434/clinica

# Direct Neon connection, set by the Vercel Neon integration. Used by drizzle-kit, not the running app.
# DATABASE_URL_UNPOOLED=
BODY_SIZE_LIMIT=8388608

# 32-byte key that wraps each patient chart key. Required in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Set DATA_KEK in the Vercel project environment for production. Local `vite dev` uses a built-in fallback when this is empty.
# DATA_KEK=
# Separate Postgres database for chart keys. On Vercel, add an environment variable named KEYS_DATABASE_URL
# with that database's pooled connection string. Shredding is complete once this store and its backups no longer have the key.
# KEYS_DATABASE_URL=
# Read-write token for the private Vercel Blob store that holds uploads. Required in production.
# Local `vite dev` writes uploads to data/uploads when this is empty.
# BLOB_READ_WRITE_TOKEN=
