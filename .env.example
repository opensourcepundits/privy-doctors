# Local Docker Postgres. On Vercel, the Neon integration replaces this with the pooled Neon URL.
DATABASE_URL=postgres://clinica:clinica@localhost:5434/clinica

# Direct Neon connection, set by the Vercel Neon integration. Used by drizzle-kit, not the running app.
# DATABASE_URL_UNPOOLED=
BODY_SIZE_LIMIT=8388608
